# Public client config baked into the private Even Hub build.
# Copy to .env.production.local and fill in your deployed Vercel URL before packing.

VITE_GEMINI_TOKEN_URL=https://YOUR_VERCEL_DOMAIN/api/token

# Optional override for the Even AI text-agent endpoint shown in the plugin.
# Leave commented unless it differs from VITE_GEMINI_TOKEN_URL's Vercel origin.
# VITE_EVEN_AI_AGENT_URL=https://YOUR_VERCEL_DOMAIN/api/v1/chat/completions

# Optional private-build guard. This is bundled into the .ehpk, so treat it as
# abuse friction for your private package, not as a true secret for public apps.
# If set here, set the same value as GEMINI_TOKEN_CLIENT_KEY in Vercel.
VITE_GEMINI_TOKEN_CLIENT_KEY=

# Keep public builds quiet by default. Set either to 1 only while debugging.
VITE_VERBOSE_DIAGNOSTICS=0
VITE_SHOW_DIAGNOSTICS=0
